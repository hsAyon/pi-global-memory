{
  "name": "pi-global-memory",
  "version": "0.3.0",
  "description": "Indexed, budgeted, on-demand global memory for the pi coding agent: facts, research findings, and proven fixes, retrieved instead of re-researched.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "memory",
    "knowledge-base",
    "retrieval"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test",
    "test:offline": "node --test test/offline.test.ts",
    "check": "node scripts/load-check.mjs",
    "verify": "npm run test && npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "typebox": "^1.3.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "lib/",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ]
}
